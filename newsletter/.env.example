# Copy this file to .env and fill in real values for local testing.
# For production, set these as GitHub Secrets — never commit .env with real values.

# Anthropic (Claude AI) — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Resend (email delivery) — get at resend.com
RESEND_API_KEY=re_your_resend_key_here

# Your personal email address (where the newsletter is delivered)
NEWSLETTER_TO_EMAIL=your@email.com

# The sender email (must be verified in your Resend account)
NEWSLETTER_FROM_EMAIL=newsletter@yourdomain.com

# NewsAPI — get a free key at newsapi.org
NEWSAPI_KEY=your_newsapi_org_key_here

# Set to "true" to skip sending email and print HTML to console instead (useful for testing)
DRY_RUN=false
