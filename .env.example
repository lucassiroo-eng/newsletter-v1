# Copy this file to .env and fill in real values for local testing.
# For production, set these as GitHub Secrets - never commit .env with real values.

# Anthropic Claude API - get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Resend (email delivery) - get FREE at resend.com (3,000 emails/month free)
RESEND_API_KEY=re_your_resend_key_here

# Your personal email address (where the newsletter is delivered)
NEWSLETTER_TO_EMAIL=your@email.com

# The sender email shown in the email (must be verified in your Resend account)
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev

# Set to "true" to skip sending email and print HTML to console instead
DRY_RUN=false
