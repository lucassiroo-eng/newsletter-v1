# Copy this file to .env and fill in real values for local testing.
# For production, set these as GitHub Secrets — never commit .env with real values.

# Google Gemini AI — get FREE at aistudio.google.com (no credit card needed)
# Go to: aistudio.google.com → "Get API key" → "Create API key"
GEMINI_API_KEY=AIza-your-key-here

# Resend (email delivery) — get FREE at resend.com (3,000 emails/month free)
# Go to: resend.com → Sign up → API Keys → Create API Key
RESEND_API_KEY=re_your_resend_key_here

# Your personal email address (where the newsletter is delivered)
NEWSLETTER_TO_EMAIL=your@email.com

# The sender email shown in the email (must be verified in your Resend account)
# Simplest option: use "onboarding@resend.dev" for testing, then set up your own domain
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev

# Set to "true" to skip sending email and print HTML to console instead (useful for testing)
DRY_RUN=false
